# ── Required ──────────────────────────────────────────────────────────────────
# Login credentials
LOGIN_USERNAME=admin
# Generate hash: htpasswd -bnBC 12 "" yourpassword | tr -d ':\n'
# Or in Java: new BCryptPasswordEncoder().encode("yourpassword")
LOGIN_PASSWORD_HASH=<your password>

# LLM provider API key (OpenAI, Groq, OpenRouter, etc.)
OPENAI_API_KEY=<your API key>

# ── Optional (with defaults) ───────────────────────────────────────────────
# Ollama (default) — use 127.0.0.1, NOT localhost (Docker Desktop hijacks localhost → 172.17.0.2)
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=llama3.2
# Cloud alternative (uncomment and set OPENAI_API_KEY):
#LLM_BASE_URL=https://api.groq.com/openai/v1
#LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# IBM Watsonx (leave empty if not using Watsonx)
WATSONX_PROJECT_ID=

# Storage
DATA_DIR=data
REPORT_OUTPUT_DIR=reports

# Server
FLASK_PORT=8080
PERMANENT_SESSION_LIFETIME=3600
SYNC_INTERVAL_SECONDS=30
CRON_VALIDATION_INTERVAL_SECONDS=3600

# Logging
LOG_LEVEL=INFO

# ── IBM Box sync (optional) ────────────────────────────────────────────────────
# Box App: vacation-planner-assistant
# Authentication: Client Credentials Grant (CCG) — Server Authentication
# App Access Level: App Access Only
#
# Set BOX_ENABLED=true and provide the four CCG credentials below to sync the
# master Excel file to IBM Box after every successful Add/Delete Vacation operation.
# Leave BOX_ENABLED=false (or unset) to disable — no credentials are required.
#
# How to obtain credentials (Box Developer Console):
#   1. Create a Custom App → choose "Client Credentials Grant (CCG)"
#   2. Set App Access Level → "App Access Only"
#   3. Enable scope: "Write all files and folders stored in Box"
#   4. Submit for Admin Authorization in your Box Admin Console
#   5. Copy Client ID and Client Secret from the Configuration tab
#   6. Enterprise ID: Admin Console → Account & Billing (numeric, e.g. 123456)
#   7. Share the target Box folder with the app Service Account (Editor role)
#   8. Copy the numeric folder ID from the Box folder URL
BOX_ENABLED=false
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_ENTERPRISE_ID=
# Target folder ID in IBM Box (the numeric ID from the Box URL)
BOX_FOLDER_ID=
# Retry back-off base interval in seconds (default: 60)
BOX_RETRY_BACKOFF_SECONDS=60
# TCP connect timeout in seconds (default: 30)
BOX_CONNECT_TIMEOUT_SECONDS=30
# HTTP read timeout in seconds — must cover large file uploads (default: 120)
BOX_READ_TIMEOUT_SECONDS=120

# ── Cross-year booking override (testing only) ────────────────────────────────
# Bypasses the Q4 calendar-window check for advance vacation booking.
# When true, bookings into Q1 of the next year are permitted regardless of
# today's month. Set to false (or leave unset) in production.
CROSS_YEAR_BOOKING_OVERRIDE=false

# ── Slack notifications (optional) ───────────────────────────────────────────
# Set SLACK_ENABLED=true to notify admins on Slack when a PC-type vacation is
# added or deleted via the chat UI. Leave SLACK_ENABLED=false (or unset) to disable.
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...
# Leave code that triggers the PC-leave notification (default: PC)
SLACK_PC_LEAVE_CODE=PC

# Dedicated webhook for CRITICAL admin alerts (missing vacation planner data).
# This channel receives alerts independently of SLACK_ENABLED — it fires whenever
# this URL is set, so critical provisioning issues are never silently dropped.
# Point this at an admin-only Slack channel (e.g. #holiday-admin-alerts).
# Leave empty to fall back to the main SLACK_WEBHOOK_URL (requires SLACK_ENABLED=true).
SLACK_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...

# Slack Bot Token + Channel ID — required for Team Forecast file uploads.
# The full forecast table is uploaded as a plain-text file snippet (no character limit),
# bypassing the Slack block text 3 000-char limit that causes truncation on large teams.
#
# How to get the Bot Token:
#   1. Go to api.slack.com/apps → your app → OAuth & Permissions
#   2. Add the "files:write" Bot Token Scope, then (re-)install the app to your workspace
#   3. Copy the Bot User OAuth Token (starts with xoxb-)
#
# How to get the Channel ID:
#   1. Open the target Slack channel → click the channel name → scroll to the bottom
#   2. Copy the Channel ID (starts with C, e.g. C01ABC1234)
#   3. Invite the bot to the channel: /invite @YourAppName
#
# Leave both empty to disable file upload (the webhook summary message still fires).
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C...

# Controls the format used to deliver the Team Forecast report via Slack.
# Set to "excel" to send the report as an Excel file attachment.
# Leave empty (or any other value) to use the existing plain-text/rich-text table format.
SLACK_REPORT_FORMAT=excel

EXCLUDED_CITY_LIST=West Bengal, Odisha, Tamil Nadu, Kerala
