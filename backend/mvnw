# ----------------------------------------------------------------------------
# Apache Maven Wrapper startup batch script, version 3.2.0
# ----------------------------------------------------------------------------

# If JAVA_HOME is set and valid, use it. Otherwise search PATH for java.
if [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ]; then
    javaExecutable="$JAVA_HOME/bin/java"
elif [ -x "/usr/lib/jvm/java-1.8.0/bin/java" ]; then
    javaExecutable="/usr/lib/jvm/java-1.8.0/bin/java"
else
    javaExecutable="$(which java 2>/dev/null)"
fi

if [ -z "$javaExecutable" ]; then
    echo "ERROR: JAVA_HOME is not set and no 'java' command found in PATH."
    exit 1
fi

# ---------------------------------------------------------
# Determine the Maven user home directory
# ---------------------------------------------------------
if [ -z "$MAVEN_USER_HOME" ]; then
    MAVEN_USER_HOME="$HOME/.m2"
fi

# ---------------------------------------------------------
# Read wrapper properties
# ---------------------------------------------------------
MAVEN_WRAPPER_PROPERTIES_PATH=".mvn/wrapper/maven-wrapper.properties"

distributionUrl=
if [ -f "$MAVEN_WRAPPER_PROPERTIES_PATH" ]; then
    distributionUrl=$(grep "distributionUrl" "$MAVEN_WRAPPER_PROPERTIES_PATH" | cut -d'=' -f2-)
fi

if [ -z "$distributionUrl" ]; then
    distributionUrl="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/3.9.6/apache-maven-3.9.6-bin.zip"
fi

# ---------------------------------------------------------
# Derive distribution directory name from URL
# ---------------------------------------------------------
distributionUrlName="${distributionUrl##*/}"
distributionUrlNameMain="${distributionUrlName%.*}"
MAVEN_HOME="$MAVEN_USER_HOME/wrapper/dists/$distributionUrlNameMain"

MAVEN_EXE="$MAVEN_HOME/bin/mvn"

# ---------------------------------------------------------
# Download and unpack Maven if not already present
# ---------------------------------------------------------
if [ ! -x "$MAVEN_EXE" ]; then
    echo "Downloading Apache Maven from $distributionUrl"
    mkdir -p "$MAVEN_HOME/.."

    TMP_DOWNLOAD="$MAVEN_HOME/../$distributionUrlName"

    if command -v curl > /dev/null 2>&1; then
        curl -fsSL -o "$TMP_DOWNLOAD" "$distributionUrl" || { echo "ERROR: Failed to download Maven."; exit 1; }
    elif command -v wget > /dev/null 2>&1; then
        wget -q -O "$TMP_DOWNLOAD" "$distributionUrl" || { echo "ERROR: Failed to download Maven."; exit 1; }
    else
        echo "ERROR: Neither curl nor wget found. Cannot download Maven."
        exit 1
    fi

    unzip -q "$TMP_DOWNLOAD" -d "$MAVEN_HOME/.." || { echo "ERROR: Failed to unzip Maven archive."; exit 1; }
    rm -f "$TMP_DOWNLOAD"

    # The zip unpacks a single top-level directory; move its contents to MAVEN_HOME
    UNPACKED_DIR=$(find "$MAVEN_HOME/.." -maxdepth 1 -type d -name "apache-maven-*" | head -1)
    if [ -n "$UNPACKED_DIR" ] && [ "$UNPACKED_DIR" != "$MAVEN_HOME" ]; then
        mv "$UNPACKED_DIR" "$MAVEN_HOME"
    fi

    chmod +x "$MAVEN_EXE" 2>/dev/null || true
    echo "Maven installed to $MAVEN_HOME"
fi

# ---------------------------------------------------------
# Execute Maven
# ---------------------------------------------------------
exec "$MAVEN_EXE" "$@"
